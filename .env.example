# Spring Boot backend that Next.js proxies /api/* to (see next.config.mjs)
BACKEND_URL=http://localhost:8065

# Leave empty to call the API through the Next.js proxy (avoids CORS).
# Set to a full URL only if the backend has CORS enabled for this origin.
NEXT_PUBLIC_API_URL=

# true = require sign-in (POST /api/v1/auth/login) and hide modules the user's roles don't grant.
# The backend seeds an 'admin' user with the Super Admin role on startup (see app.seed.* in application.properties).
NEXT_PUBLIC_AUTH_ENABLED=false
